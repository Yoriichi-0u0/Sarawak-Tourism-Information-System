etica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.39;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-state" target="p1-record"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-46" value="current draft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;startArrow=ERzeroToOne;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#3A3A3A;strokeWidth=1.2;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-state" target="p1-version"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-47" value="published" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;startArrow=ERzeroToOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#3A3A3A;strokeWidth=1.2;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.78;exitDx=0;exitDy=0;entryX=1;entryY=0.78;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-state" target="p1-version"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-48" value="belongs to" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#3A3A3A;strokeWidth=1.2;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-destlink" target="p1-version"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="630"/><mxPoint x="340" y="630"/></Array></mxGeometry></mxCell><mxCell id="p1-49" value="points at a destination" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#3A3A3A;strokeWidth=1.2;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.375;exitY=0;exitDx=0;exitDy=0;entryX=0.83;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-destlink" target="p1-record"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-50" value="is logged for" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#3A3A3A;strokeWidth=1.2;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.825;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-activity" target="p1-record"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="716"/><mxPoint x="910" y="396"/></Array></mxGeometry></mxCell><mxCell id="p1-51" value="Notes" style="text;html=0;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="420" width="220" height="18" as="geometry"/></mxCell><mxCell id="p1-52" value="A tourism record is never deleted:&#10;withdrawal clears its published version, so&#10;trips keep the stop and show it as&#10;unavailable.&#10;Deleting an account removes its sessions,&#10;recovery codes and owned trips; history&#10;keeps the change without the author.&#10;Crow's foot marks show the cardinality&#10;PostgreSQL enforces." style="text;html=0;align=left;verticalAlign=top;fontSize=9;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="440" width="226" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 Physical: accounts and itineraries"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shad