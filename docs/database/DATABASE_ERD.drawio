=ERzeroToMany;endFill=0;startFill=0;endSize=10;startSize=10;strokeColor=#3A3A3A;strokeWidth=1.2;fontSize=9;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-record_version-author_id" target="p3-account-id"><mxGeometry x="0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="894" y="229"/><mxPoint x="894" y="511"/></Array></mxGeometry></mxCell><mxCell id="p3-105" value="SET NULL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;endSize=10;startSize=10;strokeColor=#3A3A3A;strokeWidth=1.2;fontSize=9;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.838;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-record_activity-actor_id" target="p3-account"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="584" y="449"/><mxPoint x="584" y="532"/><mxPoint x="875" y="532"/></Array></mxGeometry></mxCell><mxCell id="p3-106" value="API role privileges: SELECT and INSERT only on tourism_record, record_version, version_destination&#10;and record_activity (append-only); SELECT, INSERT, UPDATE, DELETE on record_state; SELECT only on&#10;schema_migration." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="318" y="572" width="560" height="40" as="geometry"/></mxCell><mxCell id="p3-107" value="" style="rounded=1;arcSize=3;html=0;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="318" y="640" width="548" height="132" as="geometry"/></mxCell><mxCell id="p3-108" value="NOTATION" style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="648" width="200" height="16" as="geometry"/></mxCell><mxCell id="p3-109" value="" style="point;html=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="334" y="678" width="1" height="1" as="geometry"/></mxCell><mxCell id="p3-110" value="" style="point;html=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="394" y="678" width="1" height="1" as="geometry"/></mxCell><mxCell id="p3-111" value="" style="html=0;endArrow=ERmandOne;endFill=0;endSize=10;startArrow=none;strokeColor=#3A3A3A;strokeWidth=1.2;" edge="1" parent="1" source="p3-109" target="p3-110"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-112" value="exactly one" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="404" y="669" width="120" height="18" as="geometry"/></mxCell><mxCell id="p3-113" value="" style="point;html=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="334" y="704" width="1" height="1" as="geometry"/></mxCell><mxCell id="p3-114" value="" style="point;html=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="394" y="704" width="1" height="1" as="geometry"/></mxCell><mxCell id="p3-115" value="" style="html=0;endArrow=ERzeroToOne;endFill=0;endSize=10;startArrow=none;strokeColor=#3A3A3A;strokeWidth=1.2;" edge="1" parent="1" source="p3-113" target="p3-114"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-116" value="zero or one" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="404" y="695" width="120" height="18" as="geometry"/></mxCell><mxCell id="p3-117" value="" style="point;html=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="334" y="730" width="1" height="1" as="geometry"/></mxCell><mxCell id="p3-118" value="" style="point;html=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="394" y="730" width="1" height="1" as="geometry"/></mxCell><mxCell id="p3-119" value="" style="html=0;endArrow=ERzeroToMany;endFill=0;endSize=10;startArrow=none;strokeColor=#3A3A3A;strokeWidth=1.2;" edge="1" parent="1" source="p3-117" target="p3-118"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-120" value="zero or more" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="404" y="721" width="120" height="18" as="geometry"/></mxCell><mxCell id="p3-121" value="PK primary key · FK foreign key · UK unique · bold = key column" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="532" y="664" width="324" height="18" as="geometry"/></mxCell><mxCell id="p3-122" value="NULL = nullable; every other column is NOT NULL" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="532" y="684" width="324" height="18" as="geometry"/></mxCell><mxCell id="p3-123" value="Line ends show cardinality enforced by PostgreSQL constraints" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="532" y="704" width="324" height="18" as="geometry"/></mxCell><mxCell id="p3-124" value="Labels or FK note: composite keys, ON DELETE (default NO ACTION)" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="532" y="724" width="324" height="18" as="geometry"/></mxCell><mxCell id="p3-125" value="Dashed table = shown in full on another page" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="532" y="744" width="324" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 Access and security model"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4-1" value="STIS database · access and security model" style="text;html=0;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1100" height="28" as="geometry"/></mxCell><mxCell id="p4-2" value="Who can reach the stis schema, and where each authorisation rule is enforced (verified against live roles, grants and policies on 25 Nov 2026)." style="text;html=0;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1100" height="18" as="geometry"/></mxCell><mxCell id="p4-3" value="Browser (tourist, staff, administrator, guest)&#10;&#10;Holds only an HttpOnly session cookie&#10;(Path=/api/, SameSite=Lax, Secure) or a guest or&#10;share token kept in the URL fragment and sent as&#10;an Authorization header." style="rounded=1;arcSize=6;html=0;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1.2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="300" height="120" as="geometry"/></mxCell><mxCell id="p4-4" value="Vercel Function (sin1): STIS API handler&#10;&#10;All per-user authorisation happens here:&#10;• session lookup by SHA-256 digest; idle and absolute expiry&#10;• staff or admin role for records; admin for staff accounts&#10;• itinerary: owner_id = session account, or guest-token&#10;digest&#10;• share-token digest gives a read-only view only&#10;• optimistic revision checks (HTTP 409)&#10;• transactions with row locks for publish and withdraw&#10;• Origin check, JSON-only bodies, size limits, throttling" style="rounded=1;arcSize=6;html=0;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#1A1A1A;fillColor=#EEF3FA;strokeColor=#2B4C7E;strokeWidth=1.2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="410" y="90" width="360" height="220" as="geometry"/></mxCell><mxCell id="p4-5" value="Database role stis_api (login through the Supavisor pooler)&#10;&#10;Not superuser · no BYPASSRLS · inherits no roles ·&#10;statement_timeout 10s&#10;USAGE on schema stis (plus PUBLIC usage of the empty public&#10;schema)&#10;No readable or writable table outside stis&#10;Append-only: no UPDATE or DELETE on tourism_record,&#10;record_version, version_destination, record_activity&#10;SELECT only on schema_migration" style="rounded=1;arcSize=6;html=0;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#1A1A1A;fillColor=#FBF5E8;strokeColor=#8A5A00;strokeWidth=1.2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="410" y="350" width="360" height="170" as="geometry"/></mxCell><mxCell id="p4-6" value="Schema stis (12 tables, owner postgres)&#10;&#10;RLS enabled on all 12 tables, one policy each:&#10;stis_api_access FOR ALL TO stis_api USING (true) WITH CHECK&#10;(true). RLS therefore admits only stis_api; it does not&#10;separate one user's rows from another's. That separation is&#10;the API's job." style="rounded=1;arcSize=6;html=0;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#1A1A1A;fillColor=#EDF6F1;strokeColor=#1F5C46;strokeWidth=1.2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="410" y="570" width="360" height="140" as="geometry"/></mxCell><mxCell id="p4-7" value="Supabase Data API (PostgREST, GraphQL): roles&#10;anon, authenticated, service_role&#10;&#10;stis is not an exposed schema and none of these&#10;roles has USAGE on it, so /rest/v1 and GraphQL&#10;cannot reach any stis table. service_role has&#10;BYPASSRLS but no grant, so it is refused too." style="rounded=1;arcSize=6;html=0;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#B3261E;strokeWidth=1.2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="570" width="290" height="140" as="geometry"/></mxCell><mxCell id="p4-8" value="postgres (schema and table owner, BYPASSRLS)&#10;&#10;Used only for migrations and inspection from the&#10;Supabase dashboard or connector; never by the&#10;running application." style="rounded=1;arcSize=6;html=0;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#1A1A1A;fillColor=#F3F4F6;strokeColor=#5B6472;strokeWidth=1.2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="570" width="300" height="140" as="geometry"/></mxCell><mxCell id="p4-9" value="Review conclusion&#10;&#10;The USING (true) policies are justified by this&#10;architecture: the browser never talks to&#10;PostgreSQL, and one server role acts for every&#10;user. They are a role gate, not row isolation.&#10;&#10;Residual risk: a leaked stis_api credential&#10;could read accounts (emails, scrypt hashes) and&#10;change itineraries, but could not rewrite&#10;publication history." style="rounded=1;arcSize=6;html=0;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1.2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="90" width="290" height="260" as="geometry"/></mxCell><mxCell id="p4-10" value="HTTPS /api/v1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;endSize=8;strokeColor=#3A3A3A;strokeWidth=1.4;fontSize=10;fontColor=#3A3A3A;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.27;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-3" target="p4-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-11" value="parameterised SQL, one role for every request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;endSize=8;strokeColor=#3A3A3A;strokeWidth=1.4;fontSize=10;fontColor=#3A3A3A;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-4" target="p4-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-12" value="grants + RLS policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;endSize=8;strokeColor=#3A3A3A;strokeWidth=1.4;fontSize=10;fontColor=#3A3A3A;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-5" target="p4-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-13" value="no USAGE: refused" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=cross;endFill=1;endSize=8;strokeColor=#B3261E;strokeWidth=1.4;fontSize=10;fontColor=#B3261E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-7" target="p4-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-14" value="migrations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;endSize=8;strokeColor=#3A3A3A;strokeWidth=1.4;fontSize=10;fontColor=#3A3A3A;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-8" target="p4-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
