{
  "name": "sarawak-tourism-information-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/domain.test.ts server/as03/system.test.ts server/as03/http.test.ts src/as03/recovery.test.ts src/as03/conflicts.test.ts src/as03/eventDates.test.ts src/as03/fieldPresentation.test.ts src/as03/sessionRecovery.test.ts src/as03/theme.test.ts src/as03/destinationSelection.test.tsx src/as03/cardMedia.test.tsx",
    "dev:as03": "node --import tsx ./node_modules/vite/bin/vite.js --mode as03 --host 127.0.0.1 --port 5183 --strictPort",
    "build:as03": "tsc -b && vite build --mode as03",
    "start:as03": "node --import tsx ./node_modules/vite/bin/vite.js preview --mode as03 --host 127.0.0.1 --port 4183 --strictPort"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
